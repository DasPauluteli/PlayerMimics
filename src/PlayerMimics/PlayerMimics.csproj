<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>com.pauluteli.PlayerMimics</AssemblyName>
    <AssemblyTitle>PlayerMimics</AssemblyTitle>
    <RootNamespace>PlayerMimics</RootNamespace>
    <RepositoryUrl>https://github.com/DasPauluteli/PlayerMimics</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <IsThunderstorePackable>true</IsThunderstorePackable>
    <ThunderstoreName>PlayerMimics</ThunderstoreName>
    <ThunderstoreDescription>Masked become impostor crewmates that look, move and (with consent) sound like your friends, run by a local AI. Host runs the free AI server.</ThunderstoreDescription>
    <ThunderstoreCommunities>lethal-company</ThunderstoreCommunities>
    <ThunderstoreCategories>mods;bepinex;serverside;monsters;audio;ai-generated</ThunderstoreCategories>
  </PropertyGroup>

  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
  </ItemGroup>

  <ItemGroup>
    <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
    <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />
    <ThunderstoreDependency Include="BepInEx-BepInExPack" Version="5.4.2305" />
    <ThunderstoreSoftDependency Include="AinaVT-LethalConfig" Version="1.4.6" />
    <ThunderstoreSoftDependency Include="EliteMasterEric-Coroner" Version="2.4.2" />
    <Reference Include="$(MortarDependency_EliteMasterEric_Coroner)*.dll" Condition="'$(MortarDependency_EliteMasterEric_Coroner)' != ''" Private="false" />
    <Reference Include="$(MortarDependency_AinaVT_LethalConfig)**/*.dll" Condition="'$(MortarDependency_AinaVT_LethalConfig)' != ''" Private="false" />
    <ThunderstoreSoftDependency Include="x753-More_Suits" Version="1.5.4" />
    <Reference Include="$(MortarDependency_x753_More_Suits)**/*.dll" Condition="'$(MortarDependency_x753_More_Suits)' != ''" Private="false" />
    <Reference Include="$(MortarDependency_EliteMasterEric_Coroner)**/*.dll" Condition="'$(MortarDependency_EliteMasterEric_Coroner)' != ''" Private="false" />
    <ThunderstoreSoftDependency Include="KlutzyBubbles-BetterEmotes" Version="1.5.8" />
    <Reference Include="$(MortarDependency_KlutzyBubbles_BetterEmotes)**/*.dll" Condition="'$(MortarDependency_KlutzyBubbles_BetterEmotes)' != ''" Private="false" />
    <ThunderstoreSoftDependency Include="notnotnotswipez-MoreCompany" Version="1.14.0" />
    <Reference Include="$(MortarDependency_notnotnotswipez_MoreCompany)**/*.dll" Condition="'$(MortarDependency_notnotnotswipez_MoreCompany)' != ''" Private="false" />
  </ItemGroup>
</Project>
